{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Cal AI: dev",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": [
        {
          "owner": "next",
          "pattern": [
            {
              "regexp": "^.*$",
              "file": 1,
              "location": 2,
              "message": 3
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".*Starting\\.\\.\\..*",
            "endsPattern": ".*Ready in.*"
          }
        }
      ],
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
