# Liara AI (OpenAI-compatible) — required for real food analysis.
# Get a key from https://console.liara.ir/ai
LIARA_API_KEY=

# Optional overrides:
# LIARA_BASE_URL=https://ai.liara.ir/api/v1
# LIARA_MODEL=openai/gpt-4o-mini

# Set DEMO_MODE=1 to skip the AI call and return mock nutrition.
# Useful for clicking through the UI without a key.
# DEMO_MODE=1
